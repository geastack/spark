{
  "name": "spark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "gea build --board amoled",
    "flash": "gea flash --board amoled",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "dev": "gea dev",
    "build:web": "gea build --target web",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc --noEmit -p tsconfig.test.json --noUnusedLocals --noUnusedParameters",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:fix": "npm run lint:ts -- --fix && npm run lint:css -- --fix",
    "format": "npm run lint:fix && prettier . --write",
    "format:check": "prettier . --check",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:ts": "eslint . --max-warnings 0",
    "characters": "node scripts/register-characters.ts",
    "prebuild": "npm run characters",
    "preflash": "npm run characters",
    "predev": "npm run characters",
    "prebuild:web": "npm run characters",
    "precheck": "npm run characters",
    "pretest": "npm run characters"
  },
  "dependencies": {
    "@geajs/core": "1.5.1",
    "@geastack/chips": "0.1.5",
    "@geastack/cli": "0.1.92",
    "@geastack/compiler": "1.0.21",
    "@geastack/core": "0.1.35",
    "@geastack/elements": "0.1.4",
    "@geastack/engine": "0.1.11",
    "@geastack/geaos": "0.1.3",
    "@geastack/geatsc-plugin-gea": "0.1.16",
    "@geastack/host": "0.1.14",
    "@geastack/targets": "0.1.91"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@geajs/vite-plugin": "1.5.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.3",
    "ejs": "^6.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.0"
  },
  "gea": {
    "id": "spark",
    "name": "Spark",
    "entry": "src/main.tsx",
    "runtime": "gea",
    "cssDevicePixelRatio": 1,
    "targets": {
      "esp32": {
        "sdkconfig": "sdkconfig.defaults"
      },
      "web": true
    },
    "defines": [
      "GEA_AUDIO_FULL_DUPLEX=1",
      "GEA_AUDIO_ECHO_CANCELLATION=1",
      "GEA_AUDIO_AEC_OUTPUT_GAIN_SCALE=3.981071706f",
      "GEA_EMBEDDED_TEXT_SPRITE_HOT_STAGE_BYTES=0",
      "GEA_EMBEDDED_WIFI_STATIC_TX_BUFFERS=8",
      "GEA_EMBEDDED_WIFI_CACHE_TX_BUFFERS=16",
      "GEA_EMBEDDED_WIFI_STATIC_RX_BUFFERS=8",
      "GEA_EMBEDDED_WIFI_DYNAMIC_RX_BUFFERS=32"
    ]
  },
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "description": "A personal AI agent built with Gea and OpenAI Realtime",
  "license": "GPL-3.0-only"
}
