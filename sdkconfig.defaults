CONFIG_LWIP_IPV6=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
CONFIG_HEAP_TRACING_OFF=y
# A 40 ms PCM upload is 2.6 KB after JSON/base64/TLS framing. Keep several
# packets in flight across the remote ACK delay instead of blocking after two.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=23040
# Release scarce Wi-Fi RX buffers as soon as a packet reaches lwIP. A slow
# TLS reader must not retain the entire driver pool and starve ACK/DNS traffic.
CONFIG_LWIP_L2_TO_L3_COPY=y
# Capture/AEC runs on CPU0. Keep UI work on CPU1 below audio priority.
# CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0 is not set
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
# CONFIG_ESP_MAIN_TASK_AFFINITY_NO_AFFINITY is not set
# Wi-Fi must not compete with the continuously rendering UI and protocol worker on
# CPU1. CPU0 owns the capture clock and has room between bounded AEC frames.
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
# CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1 is not set
# Duplex TLS otherwise spends CPU on software AES/SHA while microphone
# messages wait behind speaker traffic. Use the S3's native crypto engines.
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# Keep the receive task draining while microphone writes wait for TCP space.
# A shared lock around blocking I/O can deadlock a full receive mailbox.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=2000
# Established TLS streams must not re-enter a cross-direction handshake.
# CONFIG_MBEDTLS_SSL_RENEGOTIATION is not set
