// Generated by scripts/register-characters.ts.
import type { CharacterId } from './registry.js'
<% for (const character of animated) { -%>
import { prime as prime<%= character.name %>, paint as paint<%= character.name %> } from './<%= character.id %>/animation.js'
<% } -%>

let primed = false

export function paintCharacters(
  elapsed: number,
  level: number,
  id: CharacterId,
  advance: boolean,
): void {
  if (!primed) {
    // Evaluate every primer, even if an earlier character is not mounted yet.
    <% for (const character of animated) { -%>
    const ready<%= character.name %> = prime<%= character.name %>()
    <% } -%>

    primed = <%- animated.map(character => `ready${character.name}`).join(' && ') || 'true' %>
  }

  if (!advance) {
    return
  }

  <% for (const [index, character] of animated.entries()) { -%>
  <% if (index > 0) { %>else <% } %>if (id === '<%= character.id %>') {
    paint<%= character.name %>(elapsed, level, true)
  }
  <% } -%>
}
