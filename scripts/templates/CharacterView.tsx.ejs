// Generated by scripts/register-characters.ts.
import { Component, type GeaElement } from '@geastack/core'
import type { CharacterId } from './registry.js'
<% for (const character of characters) { -%>
import <%= character.name %> from './<%= character.id %>/View.js'
import './<%= character.id %>/styles.css'
<% } -%>

interface CharacterViewProps {
  id: CharacterId
}
export default class CharacterView extends Component<GeaElement, CharacterViewProps> {
  template({ id }: CharacterViewProps): JSX.Element {
    return (
      <div class={`character-view theme-${id}`}>
        <% for (const character of characters) { -%>
        {id === '<%= character.id %>' && <<%= character.name %> />}
        <% } -%>
      </div>
    )
  }
}
